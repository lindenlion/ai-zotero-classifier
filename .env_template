# Either export these variables in your shell before running the script
# This command can be used to export the variables from the .env file into the shell environment:
# export $(grep -v '^#' .env | xargs)
#
# Or save this file as config.txt in your working directory and fill in the values accordingly.
#
# The prompt for the AI model is defined in the file prompt.txt. 

# Zotero Configuration
# Get your library ID and create an API key at: https://www.zotero.org/settings/keys
ZOTERO_LIBRARY_ID=1111111
ZOTERO_API_KEY=abcdefghijklmnopqrstuvwxyz1234567890

# Anthropic Configuration
# Get your API key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api01234567890abcdef
ANTHROPIC_MODEL=claude-opus-4-6
