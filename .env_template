# API keys for the classifier. Export these or save as secrets.txt.
# export $(grep -v '^#' .env | xargs)
#
# Model configuration (which models to use, model names) is in config.json.
# The prompt for AI models is defined in prompt.txt.

# Zotero Configuration
# Create an API key at: https://www.zotero.org/settings/keys
ZOTERO_API_KEY=abcdefghijklmnopqrstuvwxyz1234567890

# Anthropic Configuration (Claude)
# Get your API key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api01234567890abcdef

# DeepSeek Configuration
# Get your API key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-deepseek01234567890abcdef
